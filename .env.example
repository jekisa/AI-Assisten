# =====================================================================
# Konfigurasi Environment Asisten AI Dea Trans Group
# =====================================================================

# LLM Provider Configuration (OpenAI / OpenAI-Compatible)
# Jika dikosongkan, sistem menyediakan mode Fallback / Heuristic Mock untuk pengujian
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Web Search Tool (Tavily API - https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=deatrans_knowledge
# Ambang batas distance ChromaDB (L2/Cosine). Semakin kecil distance, semakin mirip.
# Jika distance terdekat > RETRIEVAL_DISTANCE_THRESHOLD, dianggap tidak memadai -> memicu Web Search
RETRIEVAL_DISTANCE_THRESHOLD=1.40

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True
